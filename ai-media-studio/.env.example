# ============================================
# AI Media Studio 环境变量配置
# ============================================

# CodeBuddy Agent SDK（用于 Agent 对话功能）
# 通过 https://www.codebuddy.cn 获取，或运行 `codebuddy` CLI 登录
CODEBUDDY_API_KEY=

# 服务端口（可选，默认 3000）
PORT=3000

# ============================================
# 中转站 API 由前端「中转站」页面动态管理，
# 信息保存在 SQLite (data/chat.db) 中。
# ============================================
